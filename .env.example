# --- Database (Supabase Postgres) ---
DATABASE_URL=postgresql://...            # for migrations / server queries
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...  # browser-safe, for auth
SUPABASE_SECRET_KEY=sb_secret_...                        # server-only, NEVER expose to the browser

# --- Gemini (severity rating) ---
GEMINI_API_KEY=...

# --- Email (Resend) ---
RESEND_API_KEY=re_...
EMAIL_FROM="Stacklight <digest@stackdigest.eu>"

# --- Billing (Stripe) ---
STRIPE_SECRET_KEY=sk_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...           # €5/mo, up to 10 tools
STRIPE_PRICE_PRO=price_...               # €10/mo ("Full Stack"), unlimited tools

# --- Red alerts ---
# Email alerts reuse RESEND_API_KEY / EMAIL_FROM above. Discord alerts need
# NOTHING here — each user pastes their own incoming webhook URL (stored in
# alert_channels). Only Slack needs credentials, via Composio:
COMPOSIO_API_KEY=...                     # server-only, from app.composio.dev
COMPOSIO_SLACK_AUTH_CONFIG_ID=ac_...     # the Slack auth config created in the Composio dashboard

# --- Jobs (Inngest) ---
INNGEST_EVENT_KEY=...
INNGEST_SIGNING_KEY=...

# --- App ---
PUBLIC_BASE_URL=https://stackdigest.eu   # used to build links in emails
UNSUBSCRIBE_SECRET=...                    # signs one-click unsubscribe links
