# --- Database (Supabase Postgres) ---
# No browser Supabase client anymore (no accounts/login) — all DB access is
# server-side via the service-role key. NEXT_PUBLIC_SUPABASE_URL is still the
# project URL the server client points at.
DATABASE_URL=postgresql://...            # for migrations / server queries
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...        # server-only, NEVER expose to the browser

# --- Gemini (severity rating) ---
GEMINI_API_KEY=...

# --- Email (Resend) ---
RESEND_API_KEY=re_...
EMAIL_FROM="Stacklight <digest@stacklight.tamara.rocks>"   # domain must be verified in Resend

# --- Red alerts ---
# Email alerts reuse RESEND_API_KEY / EMAIL_FROM above. Discord alerts need
# NOTHING here — each user pastes their own incoming webhook URL (stored in
# alert_channels). Only Slack needs credentials, via Composio:
COMPOSIO_API_KEY=...                     # server-only, from app.composio.dev
COMPOSIO_SLACK_AUTH_CONFIG_ID=ac_...     # the Slack auth config created in the Composio dashboard

# --- Jobs (Inngest) ---
INNGEST_EVENT_KEY=...
INNGEST_SIGNING_KEY=...

# --- App ---
PUBLIC_BASE_URL=https://stacklight.tamara.rocks   # used to build links in emails
UNSUBSCRIBE_SECRET=...                    # signs one-click unsubscribe + /manage links (lib/tokens.ts)
